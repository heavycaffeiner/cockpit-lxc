msgstr "스냅샷이 파괴됩니다. 컨테이너 자체는 그대로지만 이 롤백 지점은 영구히 사라집니다."

# This container has no snapshots.
msgid "snapshots_tab.this_container_has_no_snapshots"
msgstr "이 컨테이너에는 스냅샷이 없습니다."

# This rolls $0 back to $1, taken $2. Everything written to the container since then is discarded and cannot be recovered.
msgid "snapshots_tab.this_rolls_back_to_taken_everything"
msgstr "$0을(를)  시점으로 되돌립니다($2에 생성). 그 이후 컨테이너에 기록된 모든 내용은 폐기되며 복구할 수 없습니다."

# Administrative access is required
msgid "startup_states.administrative_access_is_required"
msgstr "관리자 권한이 필요합니다"

# Cannot reach Incus
msgid "startup_states.cannot_reach_incus"
msgstr "Incus에 연결할 수 없습니다"

# Check again
msgid "startup_states.check_again"
msgstr "다시 확인"

# Copied
msgid "startup_states.copied"
msgstr "복사됨"

# Incus answered but reported the connection as untrusted, so it will not return any data. This is an Incus authorization setting rather than a Cockpit one, and granting administrative access here will not change it.
msgid "startup_states.incus_answered_but_reported_the_connection"
msgstr "Incus가 응답했지만 이 연결을 신뢰하지 않는다고 알려 데이터를 반환하지 않습니다. 이는 Cockpit이 아니라 Incus의 권한 설정이므로 여기서 관리자 권한을 켜도 바뀌지 않습니다."

# Incus does not trust this connection
msgid "startup_states.incus_does_not_trust_this_connection"
msgstr "Incus가 이 연결을 신뢰하지 않습니다"

# Incus is not installed
msgid "startup_states.incus_is_not_installed"
msgstr "Incus가 설치되어 있지 않습니다"

# Incus returned something unexpected
msgid "startup_states.incus_returned_something_unexpected"
msgstr "Incus가 예상치 못한 응답을 반환했습니다"

# No containers yet
msgid "startup_states.no_containers_yet"
msgstr "아직 컨테이너가 없습니다"

# No Incus socket was found at $0. Install Incus and start its socket unit, then reload this page.
msgid "startup_states.no_incus_socket_was_found_at"
msgstr "$0에서 Incus 소켓을 찾지 못했습니다. Incus를 설치하고 소켓 유닛을 시작한 뒤 이 페이지를 새로 고치십시오."

# The Incus socket is owned by root:incus-admin, so reading it needs administrative access. Turn it on from the access button in Cockpit's top bar. This page loads the containers by itself once you do.
msgid "startup_states.the_incus_socket_is_owned_by"
msgstr "Incus 소켓의 소유자가 root:incus-admin이라 읽으려면 관리자 권한이 필요합니다. Cockpit 상단 표시줄의 접근 버튼에서 권한을 켜십시오. 켜면 이 페이지가 알아서 컨테이너를 불러옵니다."

# This host runs Incus but has no system containers.
msgid "startup_states.this_host_runs_incus_but_has"
msgstr "이 호스트에서 Incus가 실행 중이지만 시스템 컨테이너가 없습니다."

# Try again
msgid "startup_states.try_again"
msgstr "다시 시도"

# Console for $0
msgid "terminal.console_for"
msgstr "$0 콘솔"

# Incus allows one console attachment at a time, so opening this may take the console away from another session.
msgid "terminal.incus_allows_one_console_attachment_at"
msgstr "Incus는 한 번에 하나의 콘솔 연결만 허용하므로, 여기서 열면 다른 세션의 콘솔을 가져올 수 있습니다."

# Keystrokes go to the container. Press Ctrl + Shift + Tab to move focus out of the terminal.
msgid "terminal.keystrokes_go_to_the_container_press"
msgstr "입력은 컨테이너로 전달됩니다. 터미널 밖으로 초점을 옮기려면 Ctrl + Shift + Tab을 누르십시오."

# Reconnect
msgid "terminal.reconnect"
msgstr "다시 연결"

# Session ended: $0
msgid "terminal.session_ended"
msgstr "세션 종료: $0"

# Shell for $0
msgid "terminal.shell_for"
msgstr "$0 셸"
